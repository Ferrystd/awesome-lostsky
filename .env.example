; ==========================================
; LostSky environment config
; Copy this file to .env and adjust values.
; ==========================================

APP_DEBUG = true

; ---------- Application logging ----------
; Comma-separated PSR-3 levels. SQL and debug logs are excluded by default.
LOG_LEVEL = info,notice,warning,error,critical,alert,emergency
; Empty path writes to runtime/log. Production may use /var/log/lostsky.
LOG_PATH =
LOG_MAX_FILES = 30
LOG_FILE_SIZE = 10485760
LOG_CLOSE = false

; ---------- Database ----------
DB_DRIVER = mysql
DB_TYPE   = mysql
DB_HOST   = 127.0.0.1
DB_NAME   = lostsky
DB_USER   = root
DB_PASS   =
DB_PORT   = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

; ---------- Database queue ----------
; Ability expiration jobs use the Database driver and the ability-expiration queue.
QUEUE_RETRY_AFTER = 120

; ---------- Domain ----------
; APP_DOMAIN_ROOT = localhost
; APP_DOMAIN_API  = api.localhost
;
; APP_DOMAIN_ROOT = lostsky.work
; APP_DOMAIN_API  = api.lostsky.work

; ---------- JWT ----------
; Required: generate a random secret of at least 32 characters before starting the API.
JWT_SECRET       =
; Encrypts and authenticates redemption card credentials. Use an independent 32+ character secret.
REDEMPTION_SECRET =
; jwt.algo        = HS256
; jwt.iss         = lostsky
; jwt.ttl         = 7200
; jwt.refresh_ttl = 1209600
; jwt.leeway      = 0

; ---------- Workspace entry ----------
; External Entity warning acknowledgement lifetime in seconds.
; workspace.external_warning_ttl = 86400

; ---------- Language ----------
DEFAULT_LANG = zh-cn

; ---------- Alibaba Cloud credentials / OSS ----------
ALIYUN_ACCESS_KEY_ID =
ALIYUN_ACCESS_KEY_SECRET =
ALIYUN_OSS_BUCKET =
ALIYUN_OSS_REGION =
ALIYUN_OSS_DOMAIN =

; ---------- TLS certificate deployment ----------
; One multi-SAN certificate is shared by Nginx and the OSS custom domain.
TLS_CERTIFICATE_PATH = /etc/letsencrypt/live/lostsky.work/fullchain.pem
TLS_PRIVATE_KEY_PATH = /etc/letsencrypt/live/lostsky.work/privkey.pem
; BaoTa usually uses /www/server/nginx/sbin/nginx. Use nginx when it is in PATH.
TLS_NGINX_BINARY = /www/server/nginx/sbin/nginx
; Optional comma-separated override. Defaults include the public app and nested app/API wildcards.
; TLS_REQUIRED_NAMES =

; ---------- File upload ----------
; FILE_UPLOAD_MAX_SIZE = 52428800

; ---------- Chat / Centrifugo ----------
; Browser WebSocket endpoint, normally reverse-proxied by {slug}.chat.lostsky.work
CENTRIFUGO_CLIENT_URL = /connection/websocket
; Internal Centrifugo HTTP API address
CENTRIFUGO_API_URL = http://127.0.0.1:8000
CENTRIFUGO_API_KEY =
; Must equal Centrifugo client.token.hmac_secret_key and be at least 32 characters
CENTRIFUGO_TOKEN_SECRET =
