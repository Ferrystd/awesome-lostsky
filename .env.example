# ==========================================
# LostSky 环境配置
# 复制为 .env 并修改实际值
# ==========================================

APP_DEBUG = true

# ---------- 数据库 ----------
DB_DRIVER = mysql
DB_TYPE   = mysql
DB_HOST   = 127.0.0.1
DB_NAME   = lostsky
DB_USER   = root
DB_PASS   =
DB_PORT   = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

# ---------- 域名 ----------
# 开发环境 (APP_DEBUG=true 时默认 localhost)
# app.domain_root = localhost
# app.domain_api  = api.localhost
#
# 生产环境 (APP_DEBUG=false 时默认 lostsky.work)
# app.domain_root = lostsky.work
# app.domain_api  = api.lostsky.work

# ---------- JWT ----------
# jwt.secret      =
# jwt.algo        = HS256
# jwt.iss         = lostsky
# jwt.ttl         = 7200
# jwt.refresh_ttl = 1209600
# jwt.leeway      = 0

# ---------- 语言 ----------
DEFAULT_LANG = zh-cn
