; ==========================================
; LostSky environment config
; Copy this file to .env and adjust values.
; ==========================================

APP_DEBUG = true

; ---------- Database ----------
DB_DRIVER = mysql
DB_TYPE   = mysql
DB_HOST   = 127.0.0.1
DB_NAME   = lostsky
DB_USER   = root
DB_PASS   =
DB_PORT   = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

; ---------- Domain ----------
; APP_DOMAIN_ROOT = localhost
; APP_DOMAIN_API  = api.localhost
;
; APP_DOMAIN_ROOT = lostsky.work
; APP_DOMAIN_API  = api.lostsky.work

; ---------- JWT ----------
; Required: generate a random secret of at least 32 characters before starting the API.
JWT_SECRET       =
; jwt.algo        = HS256
; jwt.iss         = lostsky
; jwt.ttl         = 7200
; jwt.refresh_ttl = 1209600
; jwt.leeway      = 0

; ---------- Language ----------
DEFAULT_LANG = zh-cn

; ---------- Aliyun OSS ----------
ALIYUN_ACCESS_KEY_ID =
ALIYUN_ACCESS_KEY_SECRET =
ALIYUN_OSS_BUCKET =
ALIYUN_OSS_REGION =
ALIYUN_OSS_DOMAIN =

; ---------- File upload ----------
; FILE_UPLOAD_MAX_SIZE = 52428800

; ---------- Chat / Centrifugo ----------
; Browser WebSocket endpoint, normally reverse-proxied by {slug}.chat.lostsky.work
CENTRIFUGO_CLIENT_URL = /connection/websocket
; Internal Centrifugo HTTP API address
CENTRIFUGO_API_URL = http://127.0.0.1:8000
CENTRIFUGO_API_KEY =
; Must equal Centrifugo client.token.hmac_secret_key and be at least 32 characters
CENTRIFUGO_TOKEN_SECRET =
