#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)

if [ -x "$root/.wiki-venv/Scripts/python.exe" ]; then
  python="$root/.wiki-venv/Scripts/python.exe"
elif [ -x "$root/.wiki-venv/bin/python" ]; then
  python="$root/.wiki-venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  python=python3
elif command -v python >/dev/null 2>&1; then
  python=python
else
  echo "Git pre-commit: 需要 Python，请先运行 npm run docs:setup。" >&2
  exit 1
fi

exec "$python" "$root/frontend/scripts/guide_modified.py"
