{
  "openapi": "3.0.3",
  "info": {
    "title": "LostSky Chat API",
    "version": "0.2.0",
    "description": "Teamless Chat API。会话与消息始终使用当前 Entity；群聊由 Team 应用管理。"
  },
  "x-entity-auth": {
    "team_belongs": false,
    "current_entity_required": true,
    "write_expected_entity_id": true
  },
  "servers": [
    {
      "url": "https://chat.api.lostsky.work"
    },
    {
      "url": "https://api.lostsky.work"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Team"
    },
    {
      "name": "Actor"
    },
    {
      "name": "Virtual"
    },
    {
      "name": "Integration"
    },
    {
      "name": "Conversation"
    },
    {
      "name": "Message"
    },
    {
      "name": "Realtime"
    },
    {
      "name": "EntityField"
    },
    {
      "name": "TeamAdmin",
      "description": "从团队后台 Origin 调用的 Chat 管理接口"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "integrationToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "创建或轮换虚拟实体集成时一次性返回的明文 API Token"
      }
    },
    "schemas": {
      "IntegrationCredentials": {
        "type": "object",
        "required": [
          "token",
          "signing_secret"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "仅创建时返回"
          },
          "token": {
            "type": "string",
            "description": "调用消息 API 的 Bearer 令牌，仅返回一次"
          },
          "signing_secret": {
            "type": "string",
            "pattern": "^whsec_[A-Za-z0-9+/]{43}=$",
            "description": "Standard Webhooks v1 密钥：32 随机字节的标准 Base64 编码；仅返回一次"
          }
        }
      },
      "IntegrationCredentialsEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/IntegrationCredentials"
              }
            }
          }
        ]
      },
      "WebhookEvent": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.created"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "kind"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "group"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.closed"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.participants.added"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "participants"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "participants": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Actor"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.participant.removed"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "participant"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "participant": {
                    "$ref": "#/components/schemas/Actor"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.created"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.updated"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.revoked"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          }
        ],
        "description": "Standard Webhooks 出站事件信封；请求头 webhook-id 为稳定投递 ID 字符串，webhook-timestamp 为发送时刻 Unix 秒，webhook-signature 为 v1,Base64签名。使用原始请求体验签。"
      },
      "Envelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {}
        }
      },
      "MessageEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "nullable": true
              }
            }
          }
        ]
      },
      "WorkspaceAccessSnapshot": {
        "type": "object",
        "required": [
          "team",
          "permissions",
          "abilities",
          "identity"
        ],
        "properties": {
          "team": {
            "type": "object",
            "required": [
              "id",
              "slug",
              "name"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "abilities": {
            "type": "object",
            "additionalProperties": true
          },
          "identity": {
            "type": "object",
            "required": [
              "type",
              "entity_id",
              "name"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "team",
                  "teamMember",
                  "teamVirtual"
                ]
              },
              "entity_id": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string",
                "nullable": true
              },
              "avatar": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Actor": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "entity",
              "customer",
              "team",
              "virtual"
            ]
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "can_act": {
            "type": "boolean"
          }
        }
      },
      "Participant": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Actor"
          },
          {
            "type": "object",
            "properties": {
              "joined_at": {
                "type": "integer",
                "format": "int64"
              },
              "left_at": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "last_read_message_id": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              }
            }
          }
        ]
      },
      "Conversation": {
        "type": "object",
        "required": [
          "uuid",
          "kind",
          "participants"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "group"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "is_temporary": {
            "type": "boolean"
          },
          "is_closed": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "last_message_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "last_message": {
            "type": "string",
            "nullable": true
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          }
        }
      },
      "Invitation": {
        "type": "object",
        "required": [
          "uuid",
          "team_id",
          "kind",
          "title",
          "is_temporary",
          "is_closed",
          "expires_at",
          "invited_at",
          "invited_by"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "team_id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "enum": [
              "group"
            ]
          },
          "title": {
            "type": "string"
          },
          "is_temporary": {
            "type": "boolean"
          },
          "is_closed": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "invited_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "invited_by": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Actor"
              }
            ],
            "nullable": true
          }
        },
        "description": "待处理群邀请的最小摘要；接受前不返回消息正文、消息时间或参与者列表。"
      },
      "InvitationListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          }
        ]
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "id",
          "conversation",
          "sender",
          "create_time"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "conversation": {
            "type": "string",
            "format": "uuid"
          },
          "sender": {
            "$ref": "#/components/schemas/Actor"
          },
          "content": {
            "type": "string",
            "nullable": true
          },
          "reply_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "edited_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "revoked_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "create_time": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "VirtualEntity": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,49}$"
          },
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Integration"
            }
          }
        }
      },
      "Integration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "driver": {
            "type": "string",
            "enum": [
              "webhook"
            ]
          },
          "endpoint_url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "EntityField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "entity",
              "customer",
              "virtual"
            ]
          },
          "field_key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value_type": {
            "type": "string"
          },
          "input_type": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {},
            "nullable": true
          },
          "is_required": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "is_searchable": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "预留字段；当前版本未接入字段值搜索，不参与可见性判断"
          },
          "can_edit": {
            "type": "boolean",
            "readOnly": true
          },
          "sort": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "system",
              "custom"
            ]
          },
          "default_value": {
            "type": "string",
            "nullable": true
          },
          "manager_scope": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "值维护范围：1=仅字段管理员，2=对象本人和字段管理员"
          },
          "visibility": {
            "type": "integer",
            "enum": [
              1,
              3,
              4,
              5,
              6
            ],
            "description": "值可见范围：1=字段管理员，3=对象本人和字段管理员，4=团队实体，5=公开，6=指定对象"
          },
          "visibility_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity_id"
              ],
              "properties": {
                "entity_id": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "description": "visibility=6 时生效"
          },
          "is_system": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    },
    "parameters": {
      "SlugQuery": {
        "name": "slug",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,49}$"
        }
      },
      "UuidQuery": {
        "name": "uuid",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "paths": {
    "/actor": {
      "get": {
        "operationId": "chatActorCurrent",
        "summary": "读取当前 Entity",
        "tags": [
          "Actor"
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/integration/message": {
      "post": {
        "tags": [
          "Integration"
        ],
        "summary": "集成使用 Bearer token 代表所属虚拟实体发送消息",
        "operationId": "chatIntegrationMessage",
        "security": [
          {
            "integrationToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "conversation",
                  "content"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "content": {
                    "type": "string"
                  },
                  "reply_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "消息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/conversation": {
      "get": {
        "operationId": "chatConversationList",
        "summary": "读取当前 Entity 会话",
        "tags": [
          "Conversation"
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/conversation/get": {
      "get": {
        "operationId": "chatConversationGet",
        "summary": "读取会话详情",
        "tags": [
          "Conversation"
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/conversation/create": {
      "post": {
        "operationId": "chatConversationCreate",
        "summary": "创建跨团队单聊",
        "tags": [
          "Conversation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_entity_id"
                ],
                "properties": {
                  "expected_entity_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/message": {
      "get": {
        "operationId": "chatMessageList",
        "summary": "读取消息",
        "tags": [
          "Message"
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/message/send": {
      "post": {
        "operationId": "chatMessageSend",
        "summary": "发送消息",
        "tags": [
          "Message"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_entity_id"
                ],
                "properties": {
                  "expected_entity_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/message/edit": {
      "post": {
        "operationId": "chatMessageEdit",
        "summary": "编辑消息",
        "tags": [
          "Message"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_entity_id"
                ],
                "properties": {
                  "expected_entity_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/message/revoke": {
      "post": {
        "operationId": "chatMessageRevoke",
        "summary": "撤回消息",
        "tags": [
          "Message"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_entity_id"
                ],
                "properties": {
                  "expected_entity_id": {
                    "type": "integer"
                  }
                }
              }
