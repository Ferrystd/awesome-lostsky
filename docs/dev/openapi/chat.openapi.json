{
  "openapi": "3.0.3",
  "info": {
    "title": "LostSky Chat API",
    "version": "0.1.1",
    "description": "LostSky 团队聊天、通用虚拟实体、Webhook 集成、统一对象字段与 Centrifugo 订阅令牌。 出站事件遵循 Standard Webhooks v1；见 WebhookEvent 和 development/webhooks.md。"
  },
  "x-entity-auth": {
    "team_business_default": [
      "team",
      "teamMember",
      "teamCustomer",
      "teamVirtual"
    ],
    "base_login_auto_member": false,
    "team_belongs": true,
    "exceptions": {
      "team_list": {
        "types": [
          "teamless",
          "team",
          "teamMember",
          "teamCustomer",
          "teamVirtual"
        ],
        "team_belongs": false
      },
      "integration_send": {
        "types": [
          "integrationToken"
        ],
        "team_belongs": false
      }
    }
  },
  "servers": [
    {
      "url": "https://api.lostsky.work",
      "description": "通过 Origin 解析 chat 应用及团队 slug"
    },
    {
      "url": "https://{slug}.chat.api.lostsky.work",
      "variables": {
        "slug": {
          "default": "demo"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Team"
    },
    {
      "name": "Actor"
    },
    {
      "name": "Virtual"
    },
    {
      "name": "Integration"
    },
    {
      "name": "Conversation"
    },
    {
      "name": "Message"
    },
    {
      "name": "Realtime"
    },
    {
      "name": "EntityField"
    },
    {
      "name": "TeamAdmin",
      "description": "从团队后台 Origin 调用的 Chat 管理接口"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "integrationToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "创建或轮换虚拟实体集成时一次性返回的明文 API Token"
      }
    },
    "schemas": {
      "IntegrationCredentials": {
        "type": "object",
        "required": [
          "token",
          "signing_secret"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "仅创建时返回"
          },
          "token": {
            "type": "string",
            "description": "调用消息 API 的 Bearer 令牌，仅返回一次"
          },
          "signing_secret": {
            "type": "string",
            "pattern": "^whsec_[A-Za-z0-9+/]{43}=$",
            "description": "Standard Webhooks v1 密钥：32 随机字节的标准 Base64 编码；仅返回一次"
          }
        }
      },
      "IntegrationCredentialsEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/IntegrationCredentials"
              }
            }
          }
        ]
      },
      "WebhookEvent": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.created"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "kind"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "group"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.closed"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.participants.added"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "participants"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "participants": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Actor"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "conversation.participant.removed"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "type": "object",
                "required": [
                  "conversation",
                  "participant"
                ],
                "properties": {
                  "conversation": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "participant": {
                    "$ref": "#/components/schemas/Actor"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.created"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.updated"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "timestamp",
              "data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "message.revoked"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "事件创建时刻，UTC RFC 3339"
              },
              "data": {
                "$ref": "#/components/schemas/ChatMessage"
              }
            }
          }
        ],
        "description": "Standard Webhooks 出站事件信封；请求头 webhook-id 为稳定投递 ID 字符串，webhook-timestamp 为发送时刻 Unix 秒，webhook-signature 为 v1,Base64签名。使用原始请求体验签。"
      },
      "Envelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {}
        }
      },
      "MessageEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "nullable": true
              }
            }
          }
        ]
      },
      "WorkspaceAccessSnapshot": {
        "type": "object",
        "required": ["team", "permissions", "abilities", "identity"],
        "properties": {
          "team": {
            "type": "object",
            "required": ["id", "slug", "name"],
            "properties": {
              "id": {"type": "integer", "format": "int64"},
              "slug": {"type": "string"},
              "name": {"type": "string"}
            }
          },
          "permissions": {"type": "array", "items": {"type": "string"}},
          "abilities": {"type": "object", "additionalProperties": true},
          "identity": {
            "type": "object",
            "required": ["type", "entity_id", "name"],
            "properties": {
              "type": {"type": "string", "enum": ["team", "teamMember", "teamVirtual"]},
              "entity_id": {"type": "integer", "format": "int64"},
              "name": {"type": "string"},
              "slug": {"type": "string", "nullable": true},
              "avatar": {"type": "string", "nullable": true}
            }
          }
        }
      },
      "Actor": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "entity",
              "customer",
              "team",
              "virtual"
            ]
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "can_act": {
            "type": "boolean"
          }
        }
      },
      "Participant": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Actor"
          },
          {
            "type": "object",
            "properties": {
              "joined_at": {
                "type": "integer",
                "format": "int64"
              },
              "left_at": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "last_read_message_id": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              }
            }
          }
        ]
      },
      "Conversation": {
        "type": "object",
        "required": [
          "uuid",
          "kind",
          "participants"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "group"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "is_temporary": {
            "type": "boolean"
          },
          "is_closed": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "last_message_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "last_message": {
            "type": "string",
            "nullable": true
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "id",
          "conversation",
          "sender",
          "create_time"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "conversation": {
            "type": "string",
            "format": "uuid"
          },
          "sender": {
            "$ref": "#/components/schemas/Actor"
          },
          "content": {
            "type": "string",
            "nullable": true
          },
          "reply_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "edited_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "revoked_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "create_time": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "VirtualEntity": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,49}$"
          },
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Integration"
            }
          }
        }
      },
      "Integration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "driver": {
            "type": "string",
            "enum": [
              "webhook"
            ]
          },
          "endpoint_url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "EntityField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "entity",
              "customer",
              "virtual"
            ]
          },
          "field_key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value_type": {
            "type": "string"
          },
          "input_type": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {},
            "nullable": true
          },
          "is_required": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "is_searchable": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "预留字段；当前版本未接入字段值搜索，不参与可见性判断"
          },
          "can_edit": {
            "type": "boolean",
            "readOnly": true
          },
          "sort": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "system",
              "custom"
            ]
          },
          "default_value": {
            "type": "string",
            "nullable": true
          },
          "manager_scope": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "值维护范围：1=仅字段管理员，2=对象本人和字段管理员"
          },
          "visibility": {
            "type": "integer",
            "enum": [
              1,
              3,
              4,
              5,
              6
            ],
            "description": "值可见范围：1=字段管理员，3=对象本人和字段管理员，4=团队实体，5=公开，6=指定对象"
          },
          "visibility_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity_id"
              ],
              "properties": {
                "entity_id": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            },
            "description": "visibility=6 时生效"
          },
          "is_system": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      }
    },
    "parameters": {
      "SlugQuery": {
        "name": "slug",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,49}$"
        }
      },
      "UuidQuery": {
        "name": "uuid",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "paths": {
    "/team": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "列出当前用户作为成员或客户加入的团队并集",
        "operationId": "chatTeamList",
        "responses": {
          "200": {
            "description": "团队列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/actor": {
      "get": {
        "tags": [
          "Actor"
        ],
        "summary": "列出当前团队可见聊天身份及通过 chat.virtual.*.act 可操作的虚拟实体",
        "operationId": "chatActorList",
        "responses": {
          "200": {
            "description": "身份列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/virtual": {
      "get": {
        "tags": [
          "Virtual"
        ],
        "summary": "按管理权限或 chat.virtual.*.act 列出虚拟实体",
        "operationId": "chatVirtualList",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "manage",
                "operate"
              ],
              "default": "manage"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "虚拟实体列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/virtual/get": {
      "get": {
        "tags": [
          "Virtual"
        ],
        "summary": "读取虚拟实体",
        "operationId": "chatVirtualGet",
        "parameters": [
          {
            "$ref": "#/components/parameters/SlugQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "虚拟实体详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/virtual/create": {
      "post": {
        "tags": [
          "Virtual"
        ],
        "summary": "创建虚拟实体",
        "operationId": "chatVirtualCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug",
                  "name"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "avatar": {
                    "type": "string",
                    "nullable": true
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/virtual/update": {
      "post": {
        "tags": [
          "Virtual"
        ],
        "summary": "更新虚拟实体；Permission 中间件从请求体 slug 解析 <slug> 并检查具体 key 与 * key 的并集",
        "operationId": "chatVirtualUpdate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "avatar": {
                    "type": "string",
                    "nullable": true
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "is_active": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/virtual/delete": {
      "post": {
        "tags": [
          "Virtual"
        ],
        "summary": "删除虚拟实体并清理具体 slug 权限",
        "operationId": "chatVirtualDelete",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/integration/create": {
      "post": {
        "tags": [
          "Integration"
        ],
        "summary": "创建虚拟实体 Webhook 集成",
        "operationId": "chatIntegrationCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug",
                  "name",
                  "endpoint_url"
                ],
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "endpoint_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "events": {
                    "type": "array",
                    "items": {
