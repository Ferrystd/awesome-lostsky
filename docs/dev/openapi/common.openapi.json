{
  "openapi": "3.0.3",
  "info": {
    "title": "LostSky Common API",
    "version": "0.0.9",
    "description": "通用上传与文档接口。调用方必须用 X-LostSky-App: common 显式选择公共应用；团队上下文仍由 Host 或 Origin 解析。"
  },
  "x-entity-auth": {
    "authenticated_default": [
      "teamMember"
    ],
    "base_login_auto_member": true,
    "team_belongs": true
  },
  "servers": [
    {
      "url": "https://api.lostsky.work",
      "description": "统一 API 域名；X-LostSky-App 显式选择 common，Origin 仅解析团队"
    },
    {
      "url": "https://{slug}.{app}.api.lostsky.work",
      "description": "API 子域名；X-LostSky-App 显式选择 common，Host 仅解析团队 slug",
      "variables": {
        "slug": {
          "default": "team-a",
          "description": "Team.slug"
        },
        "app": {
          "default": "common",
          "description": "应用名"
        }
      }
    },
    {
      "url": "https://{customDomain}",
      "description": "团队自定义域名；X-LostSky-App 显式选择 common，从 team_domain 表反查团队",
      "variables": {
        "customDomain": {
          "default": "example.com"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Upload"
    },
    {
      "name": "Document"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authorization: Bearer {token}"
      }
    },
    "parameters": {
      "PageId": {
        "name": "X-Page-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "前端页面 UUID。Dedup 优先使用 X-Request-Id；缺省请求标识时仍按登录主体、请求路径和请求内容生成短期防重键。"
      },
      "AppName": {
        "name": "X-LostSky-App",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "common"
          ]
        },
        "description": "显式选择公共上传应用；其他应用名不允许通过该请求头指定。"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        }
      },
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdQuery": {
        "name": "id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "CustomerIdQuery": {
        "name": "customer_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "schemas": {
      "SiteContent": {"type": "object", "additionalProperties": false, "required": ["icp", "members", "stats"], "properties": {"icp": {"type": "string", "maxLength": 100}, "members": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["name", "role", "description", "tags", "initials", "avatar", "visible"], "properties": {"name": {"type": "string", "maxLength": 60, "minLength": 1}, "role": {"type": "string", "maxLength": 100, "minLength": 1}, "description": {"type": "string", "maxLength": 2000, "minLength": 1}, "tags": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 30, "minLength": 1}}, "initials": {"type": "string", "maxLength": 8}, "avatar": {"type": "string", "maxLength": 2048, "description": "留空或有效的 HTTPS 图片地址；头像与姓名缩写至少提供一个"}, "visible": {"type": "boolean"}}}}, "stats": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["value", "label", "visible"], "properties": {"value": {"type": "string", "maxLength": 30, "minLength": 1}, "label": {"type": "string", "maxLength": 60, "minLength": 1}, "visible": {"type": "boolean"}}}}}},
      "SiteContentEnvelope": {"type": "object", "required": ["code", "message", "data"], "properties": {"code": {"type": "integer"}, "message": {"type": "string"}, "data": {"$ref": "#/components/schemas/SiteContent"}}},
      "AnyObject": {
        "type": "object",
        "additionalProperties": true
      },
      "AnyValue": {
        "nullable": true,
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {}
          },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {}
        }
      },
      "MessageEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "操作成功"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PermissionDeniedReason"
              },
              {
                "$ref": "#/components/schemas/AbilityDeniedReason"
              }
            ],
            "nullable": true,
            "description": "授权错误返回结构化原因；其他错误可为 null。"
          }
        }
      },
      "PermissionDeniedReason": {
        "type": "object",
        "required": [
          "kind",
          "required_any"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "permission"
            ]
          },
          "required_any": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AbilityDeniedReason": {
        "type": "object",
        "required": [
          "kind",
          "key",
          "label"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ability"
            ]
          },
          "key": {
            "type": "string",
            "example": "file"
          },
          "label": {
            "type": "string",
            "example": "文件上传"
          },
          "minimum_level": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "missing",
              "level",
              "expired"
            ]
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 1
          },
          "message": {
            "type": "string",
            "example": "参数错误"
          },
          "data": {
            "nullable": true,
            "example": null
          }
        }
      },
      "PaginationBase": {
        "type": "object",
        "required": [
          "total",
          "list",
          "page",
          "limit"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "list": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "IdResult": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        }
      },
      "LoginEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessEnvelope"
          },
          {
            "type": "object",
            "required": ["status_code", "status_label"],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/LoginResult"
              }
            }
          }
        ]
      },
      "TeamSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "slug": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "is_owner": {
            "type": "boolean"
          }
        }
      },
      "TeamProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "slug": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "introduction": {
            "type": "string",
            "nullable": true
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          }
        }
      },
      "MemberProfileFields": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 50
          },
          "avatar": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "intro_image": {
            "type": "string",
            "nullable": true
          },
          "intro_video": {
            "type": "string",
            "nullable": true
          },
          "introduction_markdown": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Member": {
        "allOf": [
          {
            "type": "object",
            "required": ["status_code", "status_label"],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "team_id": {
                "type": "integer",
                "format": "int64"
              },
              "user_id": {
                "type": "integer",
                "format": "int64"
              },
              "status_code": {
                "type": "string",
                "enum": ["active", "blocked", "departed"]
              },
              "status_label": {
                "type": "string"
              },
              "create_time": {
                "type": "integer",
                "format": "int64",
                "description": "Unix timestamp, seconds"
              }
            }
          },
          {
            "$ref": "#/components/schemas/MemberProfileFields"
          },
          {
            "type": "object",
            "properties": {
              "posts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MemberPost"
                }
              },
              "fieldValues": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EntityFieldValue"
                }
              }
            }
          }
        ]
      },
      "MemberPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type_id": {
            "type": "integer",
            "format": "int64"
          },
          "post_id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "$ref": "#/components/schemas/PostType"
          },
          "entity_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PostType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "team_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "post_id": {
            "type": "integer",
            "format": "int64"
          },
          "sort": {
            "type": "integer"
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "update_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "team_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "cost": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "handler_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "sender_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "cs_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "team_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0=false, 1=true"
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "update_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "handlers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductHandler"
            }
          },
          "entity_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "subject": {
            "$ref": "#/components/schemas/Entity"
          }
        }
      },
      "ProductHandler": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "entity_id": {
            "type": "integer",
            "format": "int64"
          },
          "subject": {
            "$ref": "#/components/schemas/Entity"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "team_id": {
            "type": "integer",
            "format": "int64"
          },
          "customer_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "handler_entity_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "sender_entity_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "total_price": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "cost": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "handler_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "sender_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "cs_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "team_cut": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "cash": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "prepaid": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "trans_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1=处理中, 2=已完成"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "update_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "handler": {
            "$ref": "#/components/schemas/Member"
          },
          "sender": {
            "$ref": "#/components/schemas/Member"
          },
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "team_id": {
            "type": "integer",
            "format": "int64"
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "is_blocked": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0=false, 1=true"
          },
          "name": {
            "type": "string"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "balance": {
            "$ref": "#/components/schemas/Balance"
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "update_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "customer_id": {
            "type": "integer",
            "format": "int64"
          },
          "balance": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "recharged": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "spent": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "create_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          },
          "update_time": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp, seconds"
          }
        }
      },
      "BalanceLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "customer_id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1=充值, 2=消费, 3=退款, 4=手动调整"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "balance_after": {
            "type": "string",
            "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
            "description": "Exact decimal string."
          },
          "trans_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
