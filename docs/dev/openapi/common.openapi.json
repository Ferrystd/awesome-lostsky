  "paths": {
    "/site-content": {
      "get": {
        "summary": "公开读取官网内容（仅可见人员与指标）",
        "operationId": "commonSiteContent",
        "security": [],
        "responses": {
          "200": {
            "description": "官网内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteContentEnvelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LostSky-App",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "common"
              ]
            }
          }
        ]
      }
    },
    "/upload": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "上传文件",
        "description": "用于头像、封面、Markdown 图片等资源附件，不要求 file.upload。上传先待使用12小时，不计额度、不在后台文件库显示；获授权业务成功保存真实附件节点时，在同一事务校验团队 File 容量并激活。未购买时容量为0级128MiB。过期未使用自动删除。响应正文始终为合法 JSON。",
        "operationId": "commonUpload",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AppName"
          },
          {
            "$ref": "#/components/parameters/PageId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "最大 50 MiB；扩展名必须属于服务端 file.allowed_extensions 白名单。"
                  },
                  "source": {
                    "type": "string",
                    "enum": ["attachment", "markdown"],
                    "default": "attachment",
                    "description": "首次入库来源类别。Markdown 编辑器上传传 markdown，其余表单附件默认 attachment；仅作来源展示，不用于授权。相同内容去重保留原记录类别。其他值返回 422。"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/FileUploadResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "当前团队或 Entity 无法使用上传入口；File 未购买时仍使用 0 级 128 MiB。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "业务错误或异常。项目统一响应信封，部分 HttpException 会使用对应 HTTP 状态码。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  }
