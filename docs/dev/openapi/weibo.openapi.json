{
  "openapi": "3.1.0",
  "info": { "title": "LostSky Weibo API", "version": "0.2.0", "description": "团队与个人微博工作台。基础访问快照及个人点单信息流安全预览无需业务 Permission；团队业务数据和本地管理使用 weibo.team.manage，个人完整信息流及业务使用内部 Entity 与 weibo.personal.use；远端发博、点赞、评论及任务启动/恢复还需要 weibo Ability。" },
  "x-authorization": {
    "team": { "permission": "weibo.team.manage", "ability_actions": ["post", "like", "comment", "taskStart", "taskResume"] },
    "personal": { "permission": "weibo.personal.use", "requires_internal_entity": true, "ability_actions": ["post", "like", "comment", "feedComment", "taskStart", "taskResume"] },
    "worker": { "permission": null, "ability": "weibo" }
  },
  "servers": [{ "url": "https://{slug}.weibo.api.lostsky.work", "variables": { "slug": { "default": "demo" } } }],
  "paths": {
    "/workspace/access": { "get": { "operationId": "weiboWorkspaceAccess", "description": "团队基本概览与授权快照；外部 Entity 必须已获得目标团队至少一个角色。", "responses": { "200": { "$ref": "#/components/responses/WorkspaceAccessSuccess" }, "403": { "$ref": "#/components/responses/PermissionDenied" } } } },
    "/accounts": { "get": { "operationId": "weiboAccounts", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/accounts/{id}": { "get": { "operationId": "weiboAccount", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/accounts/login/start": { "post": { "operationId": "weiboLoginStart", "requestBody": { "$ref": "#/components/requestBodies/LoginStart" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/accounts/login/confirm": { "post": { "operationId": "weiboLoginConfirm", "requestBody": { "$ref": "#/components/requestBodies/LoginConfirm" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/accounts/{id}/check": { "post": { "operationId": "weiboAccountCheck", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/bindings/{id}/remove": { "post": { "operationId": "weiboUnbind", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/media": { "post": { "operationId": "weiboMediaUpload", "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file", "account_id"], "properties": { "file": { "type": "string", "format": "binary" }, "account_id": { "type": "integer" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/media/{id}/content": { "get": { "operationId": "weiboMediaContent", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Authenticated image proxy", "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/posts": { "post": { "operationId": "weiboPostOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/likes": { "post": { "operationId": "weiboLikeOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/comments": { "post": { "operationId": "weiboCommentOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/tasks": { "get": { "operationId": "weiboTasks", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "post": { "operationId": "weiboTaskCreate", "requestBody": { "$ref": "#/components/requestBodies/TaskWrite" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/tasks/{id}": { "get": { "operationId": "weiboTask", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "post": { "operationId": "weiboTaskEdit", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/TaskWrite" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "description": "Version conflict" } } } },
    "/tasks/{id}/pause": { "post": { "operationId": "weiboTaskPause", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/tasks/{id}/start": { "post": { "operationId": "weiboTaskStart", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/tasks/{id}/resume": { "post": { "operationId": "weiboTaskResume", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/tasks/{id}/cancel": { "post": { "operationId": "weiboTaskCancel", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/operations": { "get": { "operationId": "weiboOperations", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/comment-presets": { "get": { "operationId": "weiboTeamCommentPresets", "responses": { "200": { "$ref": "#/components/responses/CommentPresetsSuccess" } } }, "post": { "operationId": "weiboTeamCommentPresetsReplace", "requestBody": { "$ref": "#/components/requestBodies/CommentPresetsReplace" }, "responses": { "200": { "$ref": "#/components/responses/CommentPresetsSuccess" } } } },

    "/personal/accounts": { "get": { "operationId": "weiboPersonalAccounts", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/accounts/{id}": { "get": { "operationId": "weiboPersonalAccount", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/accounts/login/start": { "post": { "operationId": "weiboPersonalLoginStart", "requestBody": { "$ref": "#/components/requestBodies/LoginStart" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/accounts/login/confirm": { "post": { "operationId": "weiboPersonalLoginConfirm", "requestBody": { "$ref": "#/components/requestBodies/LoginConfirm" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/accounts/{id}/check": { "post": { "operationId": "weiboPersonalAccountCheck", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/bindings/{id}/remove": { "post": { "operationId": "weiboPersonalUnbind", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/media": { "post": { "operationId": "weiboPersonalMediaUpload", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/media/{id}/content": { "get": { "operationId": "weiboPersonalMediaContent", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Authenticated image proxy", "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/personal/posts": { "post": { "operationId": "weiboPersonalPostOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/likes": { "post": { "operationId": "weiboPersonalLikeOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/comments": { "post": { "operationId": "weiboPersonalCommentOnce", "requestBody": { "$ref": "#/components/requestBodies/ManualOperation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/tasks": { "get": { "operationId": "weiboPersonalTasks", "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "post": { "operationId": "weiboPersonalTaskCreate", "requestBody": { "$ref": "#/components/requestBodies/TaskWrite" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/tasks/{id}": { "get": { "operationId": "weiboPersonalTask", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "post": { "operationId": "weiboPersonalTaskEdit", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/TaskWrite" }, "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/tasks/{id}/pause": { "post": { "operationId": "weiboPersonalTaskPause", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/tasks/{id}/start": { "post": { "operationId": "weiboPersonalTaskStart", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/tasks/{id}/resume": { "post": { "operationId": "weiboPersonalTaskResume", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/tasks/{id}/cancel": { "post": { "operationId": "weiboPersonalTaskCancel", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/operations": { "get": { "operationId": "weiboPersonalOperations", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/personal/feed": { "get": { "operationId": "weiboPersonalFeed", "description": "内部 Entity 可读取。缺少 weibo.personal.use 或 Weibo Ability 时只返回不可复原的安全预览。", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }], "responses": { "200": { "$ref": "#/components/responses/FeedSuccess" } } } },
    "/personal/feed/{id}": { "get": { "operationId": "weiboPersonalFeedItem", "description": "按本地信息流帖子 ID 读取完整条目。要求当前内部 Entity 持有 weibo.personal.use 且团队 Weibo Ability 可用；帖子必须已接受判定且未过期。", "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "$ref": "#/components/responses/FeedItemSuccess" }, "403": { "$ref": "#/components/responses/FeedItemDenied" }, "404": { "$ref": "#/components/responses/Success" } } } },
    "/personal/feed/{id}/comments": { "post": { "operationId": "weiboPersonalFeedComment", "parameters": [{ "$ref": "#/components/parameters/Id" }], "requestBody": { "$ref": "#/components/requestBodies/FeedComment" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/AbilityDenied" } } } },
    "/personal/comment-presets": { "get": { "operationId": "weiboPersonalCommentPresets", "responses": { "200": { "$ref": "#/components/responses/CommentPresetsSuccess" } } }, "post": { "operationId": "weiboPersonalCommentPresetsReplace", "requestBody": { "$ref": "#/components/requestBodies/CommentPresetsReplacePersonal" }, "responses": { "200": { "$ref": "#/components/responses/CommentPresetsSuccess" } } } }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
    },
    "responses": {
      "Success": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "WorkspaceAccessSuccess": { "description": "Workspace access snapshot", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/WorkspaceAccess" } } }] } } } },
      "AbilityDenied": { "description": "Weibo Ability is missing or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AbilityError" } } } },
      "PermissionDenied": { "description": "Required Permission or target-team workspace role is missing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
      ,"FeedSuccess": { "description": "Global order-intent feed", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/FeedList" } } }] } } } }
      ,"FeedItemSuccess": { "description": "Complete order-intent feed item", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/FeedPost" } } }] } } } }
      ,"FeedItemDenied": { "description": "Personal feed Permission or Weibo Ability is missing", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/Envelope" }, { "$ref": "#/components/schemas/AbilityError" }] } } } }
      ,"CommentPresetsSuccess": { "description": "Comment presets", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CommentPreset" } } } }] } } } }
    },
    "requestBodies": {
      "LoginStart": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["phone"], "properties": { "phone": { "type": "string" }, "expected_entity_id": { "type": "integer" } } } } } },
      "LoginConfirm": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["challenge_id", "code"], "properties": { "challenge_id": { "type": "string" }, "code": { "type": "string" }, "expected_entity_id": { "type": "integer" } } } } } },
      "ManualOperation": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["account_id"], "properties": { "account_id": { "type": "integer" }, "topic": { "type": "string" }, "content": { "type": "string" }, "status_url": { "type": "string", "format": "uri", "description": "Direct weibo.com or m.weibo.cn status URL for like and comment operations" }, "comment": { "type": "string" }, "media_ids": { "type": "array", "maxItems": 9, "items": { "type": "integer" } }, "expected_entity_id": { "type": "integer" } } } } } },
      "TaskWrite": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskWrite" } } } }
      ,"CommentPresetsReplace": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["contents"], "properties": { "contents": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } } } } } } }
      ,"CommentPresetsReplacePersonal": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["contents", "expected_entity_id"], "properties": { "contents": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "expected_entity_id": { "type": "integer" } } } } } }
      ,"FeedComment": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["account_id", "comment", "expected_entity_id"], "properties": { "account_id": { "type": "integer" }, "comment": { "type": "string", "minLength": 1, "maxLength": 500 }, "expected_entity_id": { "type": "integer" } } } } } }
    },
    "schemas": {
      "Envelope": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": {} } },
      "WorkspaceAccess": {
        "type": "object",
        "required": ["team", "permissions", "abilities", "identity", "entry_warning"],
        "properties": {
          "team": { "type": "object", "required": ["id", "slug", "name"], "properties": { "id": { "type": "integer" }, "slug": { "type": "string" }, "name": { "type": "string" } } },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "abilities": { "type": "object", "additionalProperties": { "type": "object", "required": ["enabled", "reason", "label"], "properties": { "enabled": { "type": "boolean" }, "reason": { "type": ["string", "null"] }, "label": { "type": "string" } } } },
          "identity": { "type": "object", "required": ["type", "entity_id", "name", "belongs_to_team", "is_external"], "properties": { "type": { "type": "string", "enum": ["team", "teamMember", "teamCustomer", "teamVirtual"] }, "entity_id": { "type": "integer" }, "name": { "type": "string" }, "slug": { "type": ["string", "null"] }, "avatar": { "type": ["string", "null"] }, "belongs_to_team": { "type": "boolean" }, "is_external": { "type": "boolean" } } },
          "entry_warning": { "type": "object", "required": ["required", "kind", "ttl_seconds"], "properties": { "required": { "type": "boolean" }, "kind": { "type": ["string", "null"], "enum": ["external_entity", null] }, "ttl_seconds": { "type": "integer", "minimum": 60, "default": 86400 } } }
        }
      },
      "AbilityError": { "type": "object", "required": ["code", "message", "data"], "properties": { "code": { "type": "integer", "const": 40303 }, "message": { "type": "string" }, "data": { "type": "object", "required": ["kind", "key", "reason"], "properties": { "kind": { "const": "ability" }, "key": { "const": "weibo" }, "reason": { "type": "string" } } } } },
      "TaskWrite": { "type": "object", "required": ["operation_type", "topic", "account_ids", "start_at", "min_interval", "max_interval"], "properties": { "operation_type": { "type": "string", "enum": ["Post", "Checkin"] }, "topic": { "type": "string" }, "content": { "type": "string" }, "account_ids": { "type": "array", "minItems": 1, "items": { "type": "integer" } }, "media_ids": { "type": "array", "maxItems": 9, "items": { "type": "integer" } }, "start_at": { "type": "integer" }, "min_interval": { "type": "integer", "minimum": 1 }, "max_interval": { "type": "integer", "minimum": 1 }, "expected_version": { "type": "integer" }, "expected_entity_id": { "type": "integer" } } },
      "Task": { "type": "object", "required": ["id", "operation_type", "version", "status", "block_reason", "next_run_at"], "properties": { "id": { "type": "integer" }, "operation_type": { "type": "string", "enum": ["Post", "Checkin"] }, "version": { "type": "integer" }, "status": { "type": "string", "enum": ["Paused", "Active", "BlockedLogin", "BlockedAbility", "Cancelled"] }, "block_reason": { "type": ["string", "null"] }, "next_run_at": { "type": ["integer", "null"] } } }
      ,"FeedPost": { "type": "object", "required": ["id", "text", "posted_at", "restricted"], "properties": { "id": { "type": "integer" }, "text": { "type": "string" }, "author_name": { "type": "string" }, "posted_at": { "type": "integer" }, "status_url": { "type": "string", "format": "uri" }, "app_url": { "type": "string" }, "restricted": { "type": "boolean" } } }
      ,"FeedList": { "type": "object", "required": ["list", "total", "page", "limit", "restricted", "updated_at", "poll_status", "last_error"], "properties": { "list": { "type": "array", "items": { "$ref": "#/components/schemas/FeedPost" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "limit": { "type": "integer", "maximum": 50 }, "restricted": { "type": "boolean" }, "updated_at": { "type": "integer" }, "poll_status": { "type": "string", "enum": ["unconfigured", "failed", "ready"] }, "last_error": { "type": ["string", "null"] } } }
      ,"CommentPreset": { "type": "object", "required": ["id", "content", "scope"], "properties": { "id": { "type": "integer" }, "content": { "type": "string" }, "scope": { "type": "string", "enum": ["team", "personal"] } } }
    }
  }
}
