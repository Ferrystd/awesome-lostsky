{
  "openapi": "3.0.3",
  "info": {
    "title": "LostSky Admin API",
    "version": "0.1.4",
    "description": "平台管理员后台。所有接口均要求普通 JWT 与平台管理员权限。"
  },
  "servers": [{ "url": "https://api.lostsky.work" }],
  "tags": [
    { "name": "Session" },
    { "name": "Dashboard" },
    { "name": "Users" },
    { "name": "Teams" },
    { "name": "Access" },
    { "name": "Operations" },
    { "name": "Entitlements" }
  ],
  "paths": {
    "/session": {
      "get": {
        "tags": ["Session"], "summary": "读取管理员会话", "operationId": "adminSession",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/search": {
      "get": {
        "tags": ["Session"], "summary": "搜索用户与团队", "operationId": "adminSearch",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string", "minLength": 2 } }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/dashboard": {
      "get": {
        "tags": ["Dashboard"], "summary": "读取平台总览", "operationId": "adminDashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"], "summary": "查询用户", "operationId": "adminUsers",
        "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Q" }, { "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Users"], "summary": "读取用户详情", "operationId": "adminUser",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/users/{id}/ban": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/pathItems/ModerationPost" }
    },
    "/users/{id}/unban": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/pathItems/ModerationPost" }
    },
    "/users/{id}/revoke-sessions": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/pathItems/ModerationPost" }
    },
    "/teams": {
      "get": {
        "tags": ["Teams"], "summary": "查询团队", "operationId": "adminTeams",
        "security": [{ "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Q" }, { "$ref": "#/components/parameters/Status" }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/teams/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Teams"], "summary": "读取团队详情", "operationId": "adminTeam",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/teams/{id}/ban": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/pathItems/ModerationPost" }
    },
    "/teams/{id}/unban": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "post": { "$ref": "#/components/pathItems/ModerationPost" }
    },
    "/administrators": {
      "get": {
        "tags": ["Access"], "summary": "读取平台管理员", "operationId": "adminAdministrators",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/administrators/{user_id}/roles": {
      "parameters": [{ "name": "user_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
      "put": {
        "tags": ["Access"], "summary": "更新管理员角色", "operationId": "adminAssignRoles",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleAssignmentInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/permissions": {
      "get": {
        "tags": ["Access"], "summary": "读取平台权限目录", "operationId": "adminPermissions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/roles": {
      "get": {
        "tags": ["Access"], "summary": "读取平台角色", "operationId": "adminRoles",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "tags": ["Access"], "summary": "创建平台角色", "operationId": "adminCreateRole",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminRoleInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/roles/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Access"], "summary": "读取平台角色详情", "operationId": "adminRole",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } }
      },
      "put": {
        "tags": ["Access"], "summary": "更新平台角色", "operationId": "adminUpdateRole",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminRoleInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "tags": ["Access"], "summary": "删除平台角色", "operationId": "adminDeleteRole",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/roles/{id}/permissions": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "put": {
        "tags": ["Access"], "summary": "更新角色权限", "operationId": "adminSaveRolePermissions",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["permission_keys"], "properties": { "permission_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/audit-events": {
      "get": {
        "tags": ["Operations"], "summary": "查询审计日志", "operationId": "adminAuditEvents",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Limit" }, { "name": "application", "in": "query", "schema": { "type": "string" } }, { "name": "action", "in": "query", "schema": { "type": "string" } }, { "name": "resource_type", "in": "query", "schema": { "type": "string" } }, { "name": "resource_id", "in": "query", "schema": { "type": "integer" } }, { "name": "actor_user_id", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/system/health": {
      "get": {
        "tags": ["Operations"], "summary": "读取系统状态", "operationId": "adminSystemHealth",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/entitlements/ability-catalog": {"get":{"tags":["Entitlements"],"operationId":"adminAbilityCatalog","summary":"Ability 目录","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/packages": {"get":{"tags":["Entitlements"],"operationId":"adminEntitlementPackages","summary":"平台权益包列表","responses":{"200":{"$ref":"#/components/responses/Success"}}},"post":{"tags":["Entitlements"],"operationId":"adminCreateEntitlementPackage","summary":"创建平台权益包","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/packages/{id}": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"tags":["Entitlements"],"operationId":"adminEntitlementPackage","summary":"平台权益包详情","responses":{"200":{"$ref":"#/components/responses/Success"}}},"post":{"tags":["Entitlements"],"operationId":"adminUpdateEntitlementPackage","summary":"更新平台权益包","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/packages/{id}/disable": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"tags":["Entitlements"],"operationId":"adminDisableEntitlementPackage","summary":"停用平台权益包","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns": {"get":{"tags":["Entitlements"],"operationId":"adminEntitlementCampaigns","summary":"体验活动列表","responses":{"200":{"$ref":"#/components/responses/Success"}}},"post":{"tags":["Entitlements"],"operationId":"adminCreateEntitlementCampaign","summary":"创建体验活动","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns/{id}": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"tags":["Entitlements"],"operationId":"adminEntitlementCampaign","summary":"体验活动详情","responses":{"200":{"$ref":"#/components/responses/Success"}}},"post":{"tags":["Entitlements"],"operationId":"adminUpdateEntitlementCampaign","summary":"更新体验活动","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns/{id}/disable": {"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"tags":["Entitlements"],"operationId":"adminDisableEntitlementCampaign","summary":"停用体验活动","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns/{id}/codes": {"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"tags":["Entitlements"],"operationId":"adminEntitlementCodes","summary":"体验码列表（不含明文）","responses":{"200":{"$ref":"#/components/responses/Success"}}},"post":{"tags":["Entitlements"],"operationId":"adminIssueEntitlementCodes","summary":"发行体验码","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns/{id}/codes/{code_id}/reveal": {"parameters":[{"$ref":"#/components/parameters/Id"},{"name":"code_id","in":"path","required":true,"schema":{"type":"integer"}}],"post":{"tags":["Entitlements"],"operationId":"adminRevealEntitlementCode","summary":"显式查看体验码","responses":{"200":{"$ref":"#/components/responses/Success"}}}},
    "/entitlements/campaigns/{id}/codes/{code_id}/disable": {"parameters":[{"$ref":"#/components/parameters/Id"},{"name":"code_id","in":"path","required":true,"schema":{"type":"integer"}}],"post":{"tags":["Entitlements"],"operationId":"adminDisableEntitlementCode","summary":"停用体验码","responses":{"200":{"$ref":"#/components/responses/Success"}}}}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Q": { "name": "q", "in": "query", "schema": { "type": "string" } },
      "Status": { "name": "status", "in": "query", "schema": { "type": "string" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
    },
    "pathItems": {
      "ModerationPost": {
        "tags": ["Users", "Teams"],
        "summary": "执行可逆治理操作",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModerationRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "responses": {
      "Success": { "description": "成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
      "Error": { "description": "业务错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "SuccessEnvelope": { "type": "object", "required": ["code", "message", "data"], "properties": { "code": { "type": "integer", "enum": [0] }, "message": { "type": "string" }, "data": {} } },
      "ErrorEnvelope": { "type": "object", "required": ["code", "message", "data"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": { "nullable": true } } },
      "AdminRole": {
        "type": "object",
        "required": ["id", "role_key", "name", "is_system"],
        "properties": {
          "id": { "type": "integer" },
          "role_key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "is_system": { "type": "integer", "enum": [0, 1] },
          "administrator_count": { "type": "integer", "minimum": 0 },
          "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      },
      "AdminSession": {
        "type": "object",
        "required": ["user", "roles", "permissions", "is_super_admin"],
        "properties": {
          "user": {
            "type": "object",
            "required": ["id", "username", "phone_masked", "email_masked"],
            "properties": {
              "id": { "type": "integer" },
              "username": { "type": "string" },
              "phone_masked": { "type": "string" },
              "email_masked": { "type": "string" }
            }
          },
          "roles": { "type": "array", "items": { "$ref": "#/components/schemas/AdminRole" } },
          "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "is_super_admin": { "type": "boolean" }
        }
      },
      "AdminPermission": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "AdminPermissionGroup": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AdminPermission" } }
        }
      },
      "ModerationRequest": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 5, "maxLength": 500 } } },
      "RoleAssignmentInput": { "type": "object", "required": ["role_ids"], "properties": { "role_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } } } },
      "AuditEvent": {
        "type": "object",
        "required": ["id", "application", "action", "resource_type", "create_time"],
        "properties": {
          "id": { "type": "integer" },
          "team_id": { "type": "integer", "nullable": true },
          "entity_id": { "type": "integer", "nullable": true },
          "authenticated_user_id": { "type": "integer", "nullable": true },
          "actor_username": { "type": "string", "nullable": true },
          "application": { "type": "string" },
          "action": { "type": "string" },
          "resource_type": { "type": "string" },
          "resource_id": { "type": "integer", "nullable": true },
          "request_id": { "type": "string", "nullable": true },
          "context": { "type": "object", "nullable": true, "additionalProperties": true },
          "create_time": { "type": "integer" }
        }
      },
      "SystemHealthCheck": {
        "type": "object",
        "required": ["key", "name", "status", "message"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
          "message": { "type": "string" }
        }
      },
      "SystemHealth": {
        "type": "object",
        "required": ["status", "checked_at", "checks", "backlogs"],
        "properties": {
          "status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
          "checked_at": { "type": "integer" },
          "checks": { "type": "array", "items": { "$ref": "#/components/schemas/SystemHealthCheck" } },
          "backlogs": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
        }
      },
      "AdminRoleInput": { "type": "object", "properties": { "role_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,49}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 50 }, "description": { "type": "string", "maxLength": 255 }, "permission_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }
    }
  }
}
