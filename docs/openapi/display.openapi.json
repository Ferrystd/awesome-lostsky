{
  "openapi": "3.0.3",
  "info": {
    "title": "LostSky Display API",
    "version": "0.1.2",
    "description": "团队公开主页、公开实体资料与公开文档接口。"
  },
  "servers": [
    {
      "url": "https://{team_slug}.display.api.lostsky.work",
      "variables": {
        "team_slug": {
          "default": "demo"
        }
      }
    }
  ],
  "paths": {
    "/profile/get": {
      "get": {
        "operationId": "displayProfileGet",
        "summary": "获取团队公开主页资料",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PublicSubject"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/entity/index": {
      "get": {
        "operationId": "displayEntityIndex",
        "summary": "获取可展示实体列表",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "teamMember",
                "teamVirtual"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/EntityPage"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/entity/get": {
      "get": {
        "operationId": "displayEntityGet",
        "summary": "获取公开实体详情",
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,49}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PublicSubject"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/entity/resolve": {
      "get": {
        "operationId": "displayEntityResolve",
        "summary": "解析公开 Markdown 中的实体引用",
        "parameters": [
          {
            "name": "slugs[]",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ResolvedEntity"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/document/index": {
      "get": {
        "operationId": "displayDocumentIndex",
        "summary": "获取公开文档列表",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "entity_slug",
            "in": "query",
            "description": "缺省时返回团队主体的公开文档。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DocumentPage"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/document/get": {
      "get": {
        "operationId": "displayDocumentGet",
        "summary": "获取公开文档正文",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PublicDocument"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        }
      },
      "PublicProfile": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "intro_image": {
            "type": "string",
            "nullable": true
          },
          "intro_video": {
            "type": "string",
            "nullable": true
          },
          "introduction_markdown": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PublicField": {
        "type": "object",
        "required": [
          "key",
          "name",
          "value_type",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value_type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "int",
              "decimal",
              "bool",
              "date",
              "datetime",
              "select",
              "multi_select",
              "json"
            ]
          },
          "value": {
            "nullable": true
          },
          "options": {
            "type": "array",
            "items": {},
            "nullable": true
          }
        }
      },
      "PublicRole": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          }
        }
      },
      "PublicSubject": {
        "type": "object",
        "required": [
          "slug",
          "type",
          "profile",
          "fields"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "team",
              "teamMember",
              "teamVirtual"
            ]
          },
          "profile": {
            "$ref": "#/components/schemas/PublicProfile"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicField"
            }
          },
          "roles": {
            "type": "array",
            "description": "实体已获授且开启公开展示的角色；团队主体为空。",
            "items": {
              "$ref": "#/components/schemas/PublicRole"
            }
          }
        }
      },
      "EntitySummary": {
        "type": "object",
        "required": [
          "slug",
          "type",
          "name"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "team",
              "teamMember",
              "teamVirtual"
            ]
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicRole"
            }
          }
        }
      },
      "EntityPage": {
        "type": "object",
        "required": [
          "total",
          "list",
          "page",
          "limit"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntitySummary"
            }
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sort",
          "update_time",
          "entity"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "sort": {
            "type": "integer"
          },
          "update_time": {
            "type": "integer",
            "format": "int64"
          },
          "entity": {
            "$ref": "#/components/schemas/EntitySummary"
          }
        }
      },
      "PublicDocument": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DocumentSummary"
          },
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "nullable": true
              }
            }
          }
        ]
      },
      "DocumentPage": {
        "type": "object",
        "required": [
          "total",
          "list",
          "page",
          "limit"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            }
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "ResolvedEntity": {
        "type": "object",
        "required": [
          "slug",
          "type",
          "display_name",
          "available"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "team",
              "teamMember",
              "teamVirtual",
              "unknown"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "team": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slug": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              }
            }
          },
          "available": {
            "type": "boolean"
          },
          "href": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "资源不存在或不可公开访问",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "ValidationError": {
        "description": "参数验证失败",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
