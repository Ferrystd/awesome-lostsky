{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@lostsky/ui/*": ["packages/ui/src/*"],
      "@lostsky/api/*": ["packages/api/src/*"],
      "@lostsky/shared/*": ["packages/shared/src/*"],
      "vue-draggable-plus": ["packages/ui/src/types/vue-draggable-plus.d.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.vue", "packages/**/*.ts", "packages/**/*.vue", "component-previews/**/*.ts", "component-previews/**/*.vue", "vite.*.ts"]
}
